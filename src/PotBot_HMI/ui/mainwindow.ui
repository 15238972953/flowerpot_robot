<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1024</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>智能花盆摆放控制系统</string>
  </property>
  <property name="styleSheet">
   <string>
    QMainWindow { background-color: #F0F2F5; }
    
    QGroupBox {
        background-color: #FFFFFF;
        border: 2px solid #DCDFE6;
        border-radius: 20px;
        margin-top: 25px;
        font-family: "Microsoft YaHei";
        font-weight: bold;
    }
    QGroupBox::title {
        subcontrol-origin: margin;
        subcontrol-position: top left;
        padding: 5px 20px;
        color: #444;
        font-size: 28px;
    }

    /* 数据监控区色块 */
    QFrame#LatCard { background-color: #B3E5FC; border: 2px solid #0288D1; border-radius: 15px; }
    QFrame#LonCard { background-color: #C8E6C9; border: 2px solid #388E3C; border-radius: 15px; }
    QFrame#YawCard { background-color: #FFF9C4; border: 2px solid #FBC02D; border-radius: 15px; }
    QFrame#CountCard { background-color: #E1BEE7; border: 2px solid #7B1FA2; border-radius: 15px; }

    /* 设置区色块 - 极度强化 */
    QFrame#SpacingCard { background-color: #E0F7FA; border: 3px solid #00ACC1; border-radius: 20px; }
    QFrame#ModeCard { background-color: #FCE4EC; border: 3px solid #D81B60; border-radius: 20px; }

    QLabel { color: #2D3436; font-family: "Microsoft YaHei"; font-weight: bold; }
    
    /* 巨大化按钮 */
    QPushButton#SettingLabel { 
        background-color: #455A64; color: white; border-radius: 20px; 
        min-height: 120px; font-size: 42px; 
    }
    QPushButton#StartLabel { 
        background-color: #0D47A1; color: white; border-radius: 20px; 
        min-height: 160px; font-size: 55px; 
    }
    QPushButton:pressed { background-color: #1A237E; }

    /* 设置区输入框 - 字号极大化适配放大窗口 */
    QSpinBox, QComboBox {
        min-height: 130px;
        font-size: 52px;
        font-weight: bold;
        border: 3px solid #B0BEC5;
        border-radius: 15px;
        background-color: #FFFFFF;
        padding: 0 20px;
    }
    QSpinBox::up-button, QSpinBox::down-button { width: 70px; }
   </string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainVLayout" stretch="1,2,7">
    <property name="spacing"><number>25</number></property>
    <property name="leftMargin"><number>30</number></property>
    <property name="topMargin"><number>20</number></property>
    <property name="rightMargin"><number>30</number></property>
    <property name="bottomMargin"><number>20</number></property>
    
    <item>
     <layout class="QHBoxLayout" name="topBar">
      <item><widget class="QLabel" name="logo"><property name="text"><string>🤖 PotBot 智能终端</string></property><property name="styleSheet"><string>font-size: 40px; color: #0D47A1;</string></property></widget></item>
      <item><spacer name="s1"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
      <item><widget class="QLabel" name="st1"><property name="text"><string>状态:</string></property><property name="styleSheet"><string>font-size: 32px;</string></property></widget></item>
      <item><widget class="QLabel" name="ReadyStatusValueLabel"><property name="text"><string>就绪</string></property><property name="styleSheet"><string>color: #2E7D32; font-size: 32px;</string></property></widget></item>
      <item><spacer name="s2"><property name="sizeHint"><size><width>30</width><height>20</height></size></property></spacer></item>
      <item><widget class="QLabel" name="bt1"><property name="text"><string>电量:</string></property><property name="styleSheet"><string>font-size: 32px;</string></property></widget></item>
      <item><widget class="QLabel" name="BatteryValueLabel"><property name="text"><string>100%</string></property><property name="styleSheet"><string>color: #E65100; font-size: 32px;</string></property></widget></item>
     </layout>
    </item>

    <item>
     <widget class="QGroupBox" name="DataBox">
      <property name="title"><string> 实时数据监控 </string></property>
      <layout class="QHBoxLayout" name="hDataLayout" stretch="1,1,1,1">
       <property name="spacing"><number>15</number></property>
       <property name="leftMargin"><number>15</number></property>
       <property name="topMargin"><number>15</number></property>
       <property name="rightMargin"><number>15</number></property>
       <property name="bottomMargin"><number>15</number></property>
       <item><widget class="QFrame" name="LatCard"><layout class="QVBoxLayout"><item><widget class="QLabel" name="t1"><property name="text"><string>纬度</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 30px;</string></property></widget></item><item><widget class="QLabel" name="LatitudeValueLabel"><property name="text"><string>0.0</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 38px;</string></property></widget></item></layout></widget></item>
       <item><widget class="QFrame" name="LonCard"><layout class="QVBoxLayout"><item><widget class="QLabel" name="t2"><property name="text"><string>经度</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 30px;</string></property></widget></item><item><widget class="QLabel" name="LongitudeValueLabel"><property name="text"><string>0.0</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 38px;</string></property></widget></item></layout></widget></item>
       <item><widget class="QFrame" name="YawCard"><layout class="QVBoxLayout"><item><widget class="QLabel" name="t3"><property name="text"><string>偏航角</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 30px;</string></property></widget></item><item><widget class="QLabel" name="YawAngleValueLabel"><property name="text"><string>0.0°</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 38px;</string></property></widget></item></layout></widget></item>
       <item><widget class="QFrame" name="CountCard"><layout class="QVBoxLayout"><item><widget class="QLabel" name="t4"><property name="text"><string>搬运数</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 30px;</string></property></widget></item><item><widget class="QLabel" name="PotCountValueLabel"><property name="text"><string>0</string></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="styleSheet"><string>font-size: 60px; color: #4A148C;</string></property></widget></item></layout></widget></item>
      </layout>
     </widget>
    </item>

    <item>
     <layout class="QHBoxLayout" name="bottomArea" stretch="4,3">
      <property name="spacing"><number>30</number></property>
